 code/cgame/cg_cvar.h    |   4 +-
 code/cgame/cg_effects.c | 282 ++++++++++++++++++++++------------------
 2 files changed, 161 insertions(+), 125 deletions(-)

diff --git a/code/cgame/cg_cvar.h b/code/cgame/cg_cvar.h
index 6ec6b3bf7..282c53ce1 100644
--- a/code/cgame/cg_cvar.h
+++ b/code/cgame/cg_cvar.h
@@ -44,7 +44,9 @@ CG_CVAR( cg_zoomFov, "cg_zoomfov", "22.5", CVAR_ARCHIVE, NULL )
