From 032cc24c68f3035884a0aa2afb1bf5d805a3ae19 Mon Sep 17 00:00:00 2001
From: WofWca <wofwca@protonmail.com>
Date: Thu, 9 Jul 2026 15:23:54 +0400
Subject: [PATCH] feat: `cg_gibsDuration`

---
 code/cgame/cg_cvar.h    | 1 +
 code/cgame/cg_effects.c | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/code/cgame/cg_cvar.h b/code/cgame/cg_cvar.h
index b22e51224..0a94b8c7d 100644
--- a/code/cgame/cg_cvar.h
+++ b/code/cgame/cg_cvar.h
@@ -86,6 +86,7 @@ CG_CVAR( cg_gibsPlayerSpeedFromKnockbackMaxFraction, "cg_gibsPlayerSpeedFromKnoc
 	"If knockback is big, this helps keep at least some fraction of player speed.\n"
 	"For example, if this is -0.75, we'll always keep at least 25%\n"
 	"of original player velocity." )
+CG_CVAR( cg_gibsDuration, "cg_gibsDuration", "5000", 0, NULL )
 CG_CVAR( cg_gibsOriginalOrigin, "cg_gibsOriginalOrigin", "0.0", 0,
 	"Whether to use the exact position where the player got gibbed\n"
 	"as the initial gibs position, instead of the position of the gibbed player\n"
diff --git a/code/cgame/cg_effects.c b/code/cgame/cg_effects.c
index eff93f46f..f1bc6608a 100644
--- a/code/cgame/cg_effects.c
+++ b/code/cgame/cg_effects.c
@@ -540,7 +540,7 @@ void CG_LaunchGib( const vec3_t origin, const vec3_t angles,
 
 	le->leType = LE_FRAGMENT;
 	le->startTime = cg.time;
-	le->endTime = le->startTime + 5000 + random() * 3000;
+	le->endTime = le->startTime + cg_gibsDuration.integer + random() * 3000;
 
 	VectorCopy( origin, re->origin );
 	AnglesToAxis( angles, re->axis );
-- 
2.55.0

