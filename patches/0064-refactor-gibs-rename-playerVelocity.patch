From a8f8a3d54db65bb17ab24f1557a78274bb204eb6 Mon Sep 17 00:00:00 2001
From: WofWca <wofwca@protonmail.com>
Date: Sun, 21 Jun 2026 15:23:26 +0400
Subject: [PATCH] refactor: gibs: rename `playerVelocity`

---
 code/cgame/cg_effects.c | 42 ++++++++++++++++++++---------------------
 code/cgame/cg_local.h   |  2 +-
 2 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/code/cgame/cg_effects.c b/code/cgame/cg_effects.c
index a2772fba6..13c9d54de 100644
--- a/code/cgame/cg_effects.c
+++ b/code/cgame/cg_effects.c
@@ -663,7 +663,7 @@ in demo playback, so that players see the same gibs
 #define	GIB_VELOCITY		250
 #define	GIB_JUMP			250
 void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
-					const vec3_t playerVelocity, const int knockbackSpeed,
+					const vec3_t playerVelocityOriginal, const int knockbackSpeed,
 					const lerpFrame_t *bodyAnimation, const int randSeed ) {
 	int i;
 	vec3_t	baseOrigin, origin, velocity;
@@ -683,7 +683,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		cg_gibsRandomVelocityFromKnockback.value * knockbackSpeed;
 	int seed = randSeed;
 
-	vec3_t playerVelocityScaled;
+	vec3_t playerVelocity;
 	float jump =
 		cg_gibsExtraVerticalVelocity.value +
 		cg_gibsVerticalVelocityFromKnockback.value * knockbackSpeed;
@@ -713,16 +713,16 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 	}
 	AngleVectors( bodyAngles, forward, right, up );
 
-	VectorScale( playerVelocity, cg_gibsInheritPlayerVelocity.value, playerVelocityScaled );
+	VectorScale( playerVelocityOriginal, cg_gibsInheritPlayerVelocity.value, playerVelocity );
 
 	if ( cg_debugGibs.integer & 0x01 ) {
 		CG_Printf( "gib:" );
 		CG_Printf( " "S_COLOR_YELLOW"%i"S_COLOR_WHITE" pieces",
 			numGibs );
 		CG_Printf( ", speeds: player: "S_COLOR_YELLOW"%.1f",
-			VectorLength( playerVelocityScaled ) );
+			VectorLength( playerVelocity ) );
 		CG_Printf( " (vertical "S_COLOR_YELLOW"%.1f"S_COLOR_WHITE")",
-			playerVelocityScaled[2] );
+			playerVelocity[2] );
 		CG_Printf( ", random: "S_COLOR_YELLOW"%.1f",
 			baseRandomVelocity );
 		CG_Printf( "\n" );
@@ -757,7 +757,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 				*baseRandomVelocity,
 			up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		if ( !skullLaunched && (Q_rand(&seed) & 1) ) {
 			CG_LaunchGib( origin, lookDirAngles, velocity, cgs.media.gibSkull, fireTrail, Q_rand(&seed) );
 			skullLaunched = qtrue;
@@ -774,7 +774,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		velocity[0] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[1] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[2] = jump + Q_crandom(&seed)*baseRandomVelocity;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		CG_LaunchGib( origin, bodyAngles, velocity, cgs.media.gibAbdomen, fireTrail, Q_rand(&seed) );
 		if (--numGibs <= 0) {
 			return;
@@ -789,7 +789,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[ROLL] += 70;
 		angles[PITCH] += 45;
@@ -806,7 +806,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		velocity[0] = 0.5*Q_crandom(&seed)*baseRandomVelocity;
 		velocity[1] = 0.5*Q_crandom(&seed)*baseRandomVelocity;
 		velocity[2] = jump + 0.5*Q_crandom(&seed)*baseRandomVelocity;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		CG_LaunchGib( origin, bodyAngles, velocity, cgs.media.gibChest, fireTrail, Q_rand(&seed) );
 		if (--numGibs <= 0) {
 			return;
@@ -820,7 +820,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		velocity[0] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[1] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[2] = jump + Q_crandom(&seed)*baseRandomVelocity;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[PITCH] -= 80;
 		angles[YAW] += 50;
@@ -844,7 +844,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		velocity[0] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[1] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[2] = jump + Q_crandom(&seed)*baseRandomVelocity;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		CG_LaunchGib( origin, bodyAngles, velocity, cgs.media.gibFoot, fireTrail, Q_rand(&seed) );
 		if (--numGibs <= 0) {
 			return;
@@ -859,7 +859,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[ROLL] -= 90;
 		angles[PITCH] -= 75;
@@ -874,7 +874,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		velocity[0] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[1] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[2] = jump + Q_crandom(&seed)*baseRandomVelocity;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		CG_LaunchGib( origin, bodyAngles, velocity, cgs.media.gibIntestine, fireTrail, Q_rand(&seed) );
 		if (--numGibs <= 0) {
 			return;
@@ -889,7 +889,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[ROLL] -= 30;
 		angles[PITCH] -= 15;
@@ -907,7 +907,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[PITCH] += 15;
 		CG_LaunchGib( origin, angles, velocity, cgs.media.gibLeg, fireTrail, Q_rand(&seed) );
@@ -927,7 +927,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[ROLL] += 90;
 		angles[YAW] += 180;
@@ -947,7 +947,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[ROLL] += 90;
 		angles[PITCH] += 10;
@@ -969,7 +969,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		// TODO seems not to be rotated well when bodyAngles is not upright
 		// (i.e. gib a dead player). Same for some other gibs.
@@ -989,7 +989,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		velocity[0] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[1] = Q_crandom(&seed)*baseRandomVelocity;
 		velocity[2] = jump + Q_crandom(&seed)*baseRandomVelocity;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[PITCH] -= 45;
 		CG_LaunchGib( origin, angles, velocity, cgs.media.gibFoot, fireTrail, Q_rand(&seed) );
@@ -1008,7 +1008,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, forward, velocity );
 		VectorMA( velocity, Q_crandom(&seed)*baseRandomVelocity, up, velocity );
 		velocity[2] += jump;
-		VectorAdd( velocity, playerVelocityScaled, velocity );
+		VectorAdd( velocity, playerVelocity, velocity );
 		VectorCopy( bodyAngles, angles );
 		angles[ROLL] += 85;
 		angles[PITCH] += 90;
@@ -1027,7 +1027,7 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 			velocity[0] = Q_crandom(&seed)*baseRandomVelocity;
 			velocity[1] = Q_crandom(&seed)*baseRandomVelocity;
 			velocity[2] = jump + Q_crandom(&seed)*baseRandomVelocity;
-			VectorAdd( velocity, playerVelocityScaled, velocity );
+			VectorAdd( velocity, playerVelocity, velocity );
 			VectorCopy( bodyAngles, angles );
 			angles[0] += Q_random(&seed) * 360;
 			angles[1] += Q_random(&seed) * 360;
diff --git a/code/cgame/cg_local.h b/code/cgame/cg_local.h
index da51ef33e..417911af3 100644
--- a/code/cgame/cg_local.h
+++ b/code/cgame/cg_local.h
@@ -1321,7 +1321,7 @@ void CG_LightningBoltBeam( vec3_t start, vec3_t end );
 void CG_ScorePlum( int client, vec3_t org, int score );
 
 void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
-				const vec3_t playerVelocity, const int knockbackSpeed,
+				const vec3_t playerVelocityOriginal, const int knockbackSpeed,
 				const lerpFrame_t *bodyAnimation, const int randSeed );
 // Same as `CG_GibPlayer`, but takes different params.
 void CG_GibPlayer2( const centity_t *cent, const entityState_t *es,
-- 
