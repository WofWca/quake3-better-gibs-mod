From 60963984ea6cde6701fa43829d502b497668ae6b Mon Sep 17 00:00:00 2001
From: WofWca <wofwca@protonmail.com>
Date: Tue, 11 Nov 2025 11:39:56 +0400
Subject: [PATCH] feat: `cg_gibsBounceFactor` CVAR

---
 code/cgame/cg_effects.c | 2 +-
 code/cgame/cg_local.h   | 1 +
 code/cgame/cg_main.c    | 2 ++
 3 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/code/cgame/cg_effects.c b/code/cgame/cg_effects.c
index 959fc427..fd6d4e31 100644
--- a/code/cgame/cg_effects.c
+++ b/code/cgame/cg_effects.c
@@ -546,7 +546,7 @@ void CG_LaunchGib( vec3_t origin, vec3_t angles, vec3_t velocity, qhandle_t hMod
 	VectorCopy( velocity, le->pos.trDelta );
 	le->pos.trTime = cg.time;
 
-	le->bounceFactor = 0.6f;
+	le->bounceFactor = cg_oldGibs.integer ? 0.6f : cg_gibsBounceFactor.value;
 
 	le->leBounceSoundType = LEBS_BLOOD;
 	le->leMarkType = LEMT_BLOOD;
diff --git a/code/cgame/cg_local.h b/code/cgame/cg_local.h
index 9f8ef673..3eb80165 100644
--- a/code/cgame/cg_local.h
+++ b/code/cgame/cg_local.h
@@ -1097,6 +1097,7 @@ extern	vmCvar_t		cg_oldGibs;
 extern	vmCvar_t		cg_gibsInheritPlayerVelocity;
 extern	vmCvar_t		cg_gibsRandomVelocity;
 extern	vmCvar_t		cg_gibsExtraVerticalVelocity;
+extern	vmCvar_t		cg_gibsBounceFactor;
 extern	vmCvar_t		cg_drawTimer;
 extern	vmCvar_t		cg_drawFPS;
 extern	vmCvar_t		cg_drawSnapshot;
diff --git a/code/cgame/cg_main.c b/code/cgame/cg_main.c
index 235f1bfe..54c6d0e8 100644
--- a/code/cgame/cg_main.c
+++ b/code/cgame/cg_main.c
@@ -103,6 +103,7 @@ vmCvar_t	cg_oldGibs;
 vmCvar_t	cg_gibsInheritPlayerVelocity;
 vmCvar_t	cg_gibsRandomVelocity;
 vmCvar_t	cg_gibsExtraVerticalVelocity;
+vmCvar_t	cg_gibsBounceFactor;
 vmCvar_t	cg_drawTimer;
 vmCvar_t	cg_drawFPS;
 vmCvar_t	cg_drawSnapshot;
@@ -226,6 +227,7 @@ static cvarTable_t cvarTable[] = {
 	{ &cg_gibsInheritPlayerVelocity, "cg_gibsInheritPlayerVelocity", "1.0", CVAR_ARCHIVE  },
 	{ &cg_gibsRandomVelocity, "cg_gibsRandomVelocity", "250", CVAR_ARCHIVE  },
 	{ &cg_gibsExtraVerticalVelocity, "cg_gibsExtraVerticalVelocity", "100", CVAR_ARCHIVE  },
+	{ &cg_gibsBounceFactor, "cg_gibsBounceFactor", "0.6", CVAR_ARCHIVE  },
 	{ &cg_draw2D, "cg_draw2D", "1", CVAR_ARCHIVE  },
 	{ &cg_drawStatus, "cg_drawStatus", "1", CVAR_ARCHIVE  },
 	{ &cg_drawTimer, "cg_drawTimer", "0", CVAR_ARCHIVE  },
-- 
