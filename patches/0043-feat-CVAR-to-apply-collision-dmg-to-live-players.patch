From 46057272658a21dc1470df82b45d139a11423f40 Mon Sep 17 00:00:00 2001
From: WofWca <wofwca@protonmail.com>
Date: Tue, 5 May 2026 22:12:12 +0400
Subject: [PATCH] feat: CVAR to apply collision dmg to live players

This affects gameplay significantly,
and is basically just for fooling around.
---
 code/game/g_active.c | 10 +++++++---
 code/game/g_cvar.h   |  2 ++
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/code/game/g_active.c b/code/game/g_active.c
index 457fbb51b..e45392a78 100644
--- a/code/game/g_active.c
+++ b/code/game/g_active.c
@@ -307,8 +307,12 @@ static void CheckCollisionDamage( gentity_t *ent, const vec3_t oldVelocity ) {
 	vec3_t		velChange;
 	int			damage;
 	float		div;
+	float		baseDamage = g_gibsOnCollisionBaseDamage.value *
+		(client->ps.pm_type == PM_DEAD
+			? 1
+			: g_gibsOnCollisionAffectLivePlayers.value);
 
-	if ( client->ps.pm_type != PM_DEAD ) {
+	if ( baseDamage == 0 ) {
 		return;
 	}
 
@@ -322,12 +326,12 @@ static void CheckCollisionDamage( gentity_t *ent, const vec3_t oldVelocity ) {
 	}
 	damage = VectorLengthSquared( velChange )
 		/ div
-		* g_gibsOnCollisionBaseDamage.value;
+		* baseDamage;
 
 	// If the player already has -39 health,
 	// gibbing from a 2-centimeter fall would not look good.
 	// So we gotta have a threshold.
-	if ( damage < g_gibsOnCollisionBaseDamage.integer ) {
+	if ( damage < baseDamage ) {
 		return;
 	}
 
diff --git a/code/game/g_cvar.h b/code/game/g_cvar.h
index a6e843d16..0f6a93be9 100644
--- a/code/game/g_cvar.h
+++ b/code/game/g_cvar.h
@@ -122,6 +122,8 @@ G_CVAR( g_gibsOnCollisionMinSpeed, "g_gibsOnCollisionMinSpeed", "1000", CVAR_ARC
 	"deal `g_gibsOnCollisionBaseDamage` or more damage to them\n"
 	"(damage increases with the square of the speed)." )
 G_CVAR( g_gibsOnCollisionBaseDamage, "g_gibsOnCollisionBaseDamage", "150", CVAR_ARCHIVE, NO_TRACK, NULL )
+G_CVAR( g_gibsOnCollisionAffectLivePlayers, "g_gibsOnCollisionAffectLivePlayers", "0.0", NO_FLAGS, TRACK,
+	"This one affects gameplay significantly, and is basically just for fun." )
 G_CVAR( g_gibsOnCollisionInheritPlayerVelocity, "g_gibsOnCollisionInheritPlayerVelocity", "1.0", CVAR_ARCHIVE, NO_TRACK, NULL )
 
 G_CVAR( g_podiumDist, "g_podiumDist", "80", NO_FLAGS, NO_TRACK, NULL )
-- 
