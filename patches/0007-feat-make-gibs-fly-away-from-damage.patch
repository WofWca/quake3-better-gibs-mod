+extern	vmCvar_t		cg_gibsExtraVerticalVelocity;
 extern	vmCvar_t		cg_drawTimer;
 extern	vmCvar_t		cg_drawFPS;
 extern	vmCvar_t		cg_drawSnapshot;
@@ -1418,7 +1421,8 @@ void CG_LightningBoltBeam( vec3_t start, vec3_t end );
 #endif
 void CG_ScorePlum( int client, vec3_t org, int score );
 
-void CG_GibPlayer( vec3_t playerOrigin, vec3_t playerAngles );
+void CG_GibPlayer( vec3_t playerOrigin, vec3_t playerAngles,
+				vec3_t playerVelocity );
 void CG_GibPlayerOld( vec3_t playerOrigin );
 void CG_BigExplode( vec3_t playerOrigin );
 
diff --git a/code/cgame/cg_localents.c b/code/cgame/cg_localents.c
index bfb1401a..1c66a1bf 100644
--- a/code/cgame/cg_localents.c
+++ b/code/cgame/cg_localents.c
@@ -691,7 +691,7 @@ void CG_AddInvulnerabilityJuiced( localEntity_t *le ) {
 		VectorClear( angles );
 
 		le->endTime = 0;
-		CG_GibPlayer( le->refEntity.origin, angles );
+		CG_GibPlayer( le->refEntity.origin, angles, le->pos.trDelta );
 	}
 	else {
 		trap_R_AddRefEntityToScene( &le->refEntity );
diff --git a/code/cgame/cg_main.c b/code/cgame/cg_main.c
index f8fe4644..5c1c7f6e 100644
