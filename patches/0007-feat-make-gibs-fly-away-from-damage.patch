 vmCvar_t	cg_oldGibs;
+vmCvar_t	cg_gibsInheritPlayerVelocity;
+vmCvar_t	cg_gibsRandomVelocity;
+vmCvar_t	cg_gibsExtraVerticalVelocity;
 vmCvar_t	cg_drawTimer;
