Subject: [PATCH] fix: gib spin from knockback, not absolute speed

---
 code/cgame/cg_effects.c | 72 ++++++++++++++++++++---------------------
 1 file changed, 35 insertions(+), 37 deletions(-)

diff --git a/code/cgame/cg_effects.c b/code/cgame/cg_effects.c
index 3f466ee81..d20c97a80 100644
--- a/code/cgame/cg_effects.c
+++ b/code/cgame/cg_effects.c
@@ -537,7 +537,7 @@ CG_LaunchGib
 */
 void CG_LaunchGib( const vec3_t origin, const vec3_t angles,
 					const vec3_t velocity, const qhandle_t hModel,
-					const qboolean fireTrail,
+					const qboolean fireTrail, const int knockbackSpeed,
 					const int randSeed ) {
 	localEntity_t	*le;
 	refEntity_t		*re;
@@ -570,11 +570,12 @@ void CG_LaunchGib( const vec3_t origin, const vec3_t angles,
 	}
 
 	if (!cg_oldGibs.integer) {
-		// `VectorLength` would be more precise, but this is faster
-		// and good enough for randomness.
-		float speedIsh = fabs(velocity[0]) + fabs(velocity[1]) + fabs(velocity[2]);
 		int i;
 		int mainRotationAxis = Q_rand(&seed) % 3;
+		// The extra factor is chosen arbitrarily, based on what feels good.
+		// It can be dropped in favor of changing the default value of the CVAR.
+		const float rotationSpeed =
+			1.6 * cg_gibsRotationFactor.value * knockbackSpeed;
 
 		le->leFlags = LEF_TUMBLE;
 		le->angles.trType = TR_LINEAR;
@@ -584,15 +585,12 @@ void CG_LaunchGib( const vec3_t origin, const vec3_t angles,
 		le->angles.trBase[PITCH] += Q_rand(&seed)&7;
 		le->angles.trBase[YAW] += Q_rand(&seed)&7;
 		le->angles.trBase[ROLL] += Q_rand(&seed)&7;
-		// TODO the tumble speed should probably depend on damage instead,
-		// or at least on random velocity.
 		for ( i = 0; i < 3; i++ ) {
 			// The numbers are not based on science, but it looks like
 			// having one axis be bigger than others makes rotation
 			// look natural (better preserve angular momentum).
 			float axisMul = mainRotationAxis == i ? 1 : 0.375;
-			le->angles.trDelta[i] = speedIsh * axisMul *
-				cg_gibsRotationFactor.value * Q_crandom(&seed);
+			le->angles.trDelta[i] = rotationSpeed * axisMul * Q_crandom(&seed);
 		}
 		if ( fireTrail ) {
 			le->light = LIGHT_GIB_FIRE_TRAIL;
@@ -940,10 +938,10 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
