From bb30173c62685d79b76a849e9b2772d84b8a8ae1 Mon Sep 17 00:00:00 2001
From: WofWca <wofwca@protonmail.com>
Date: Wed, 6 May 2026 23:29:47 +0400
Subject: [PATCH] feat: add `cg_debugGibs`

---
 code/cgame/cg_effects.c | 22 ++++++++++++++++++++++
 code/cgame/cg_event.c   | 11 +++++++++++
 code/cgame/cg_local.h   |  1 +
 code/cgame/cg_main.c    |  2 ++
 4 files changed, 36 insertions(+)

diff --git a/code/cgame/cg_effects.c b/code/cgame/cg_effects.c
index 963bd4bf..a2b0f6e7 100644
--- a/code/cgame/cg_effects.c
+++ b/code/cgame/cg_effects.c
@@ -701,6 +701,28 @@ void CG_GibPlayer( const vec3_t playerOrigin, const vec3_t playerAngles,
 
 	VectorScale( playerVelocity, cg_gibsInheritPlayerVelocity.value, playerVelocityScaled );
 
+	if ( cg_debugGibs.integer & 0x01 ) {
+		CG_Printf( "gib:" );
+		CG_Printf( " "S_COLOR_YELLOW"%i"S_COLOR_WHITE" pieces",
+			numGibs );
+		CG_Printf( ", speeds: player: "S_COLOR_YELLOW"%.1f",
+			VectorLength( playerVelocityScaled ) );
+		CG_Printf( " (vertical "S_COLOR_YELLOW"%.1f"S_COLOR_WHITE")",
+			playerVelocityScaled[2] );
+		CG_Printf( ", random: "S_COLOR_YELLOW"%.1f",
+			baseRandomVelocity );
+		CG_Printf( "\n" );
+	}
+	if ( cg_debugGibs.integer & 0x02 ) {
+		CG_Printf( "     body pitch "S_COLOR_YELLOW"%.1f",
+			AngleNormalize180( bodyAngles[PITCH] ) );
+		CG_Printf( " yaw "S_COLOR_YELLOW"%.1f",
+			AngleNormalize360( bodyAngles[YAW] ) );
+		CG_Printf( ", knockback speed "S_COLOR_YELLOW"%i", knockbackSpeed );
+		CG_Printf( ", random seed "S_COLOR_YELLOW"%i", seed );
+		CG_Printf( "\n" );
+	}
+
 	do {
 		// Note that one gib will get launched even if `numGibs == 0`.
 		// This is in line with the original behavior of `CG_GibPlayer`.
diff --git a/code/cgame/cg_event.c b/code/cgame/cg_event.c
index 8d33f553..562963f0 100644
--- a/code/cgame/cg_event.c
+++ b/code/cgame/cg_event.c
@@ -1277,6 +1277,17 @@ void CG_EntityEvent( centity_t *cent, vec3_t position ) {
 			torsoAngles[YAW] = torsoAnimation.yawAngle;
 			torsoAngles[ROLL] = 0;
 
+			if ( cg_debugGibs.integer & 0x04 ) {
+				CG_Printf("EV_GIB_PLAYER:");
+				CG_Printf(" time "S_COLOR_GREEN"%i.%03is",
+					cg.time / 1000, cg.time % 1000 );
+				CG_Printf(", targ "S_COLOR_GREEN"%i",
+					es->number );
+				CG_Printf(", usePredictedPs %s%i\n",
+					usePredictedPs ? S_COLOR_GREEN : S_COLOR_CYAN,
+					usePredictedPs );
+			}
+
 			CG_GibPlayer( cent->lerpOrigin, torsoAngles, *vel, knockbackSpeed,
 				&torsoAnimation, randSeed );
 		}
diff --git a/code/cgame/cg_local.h b/code/cgame/cg_local.h
index 4ffdfd47..a5ae714d 100644
--- a/code/cgame/cg_local.h
+++ b/code/cgame/cg_local.h
@@ -1128,6 +1128,7 @@ extern	vmCvar_t		cg_animSpeed;
 extern	vmCvar_t		cg_debugAnim;
 extern	vmCvar_t		cg_debugPosition;
 extern	vmCvar_t		cg_debugEvents;
+extern	vmCvar_t		cg_debugGibs;
 extern	vmCvar_t		cg_railTrailTime;
 extern	vmCvar_t		cg_errorDecay;
 extern	vmCvar_t		cg_nopredict;
diff --git a/code/cgame/cg_main.c b/code/cgame/cg_main.c
index 5d644276..9f58c523 100644
--- a/code/cgame/cg_main.c
+++ b/code/cgame/cg_main.c
@@ -129,6 +129,7 @@ vmCvar_t	cg_animSpeed;
 vmCvar_t	cg_debugAnim;
 vmCvar_t	cg_debugPosition;
 vmCvar_t	cg_debugEvents;
+vmCvar_t	cg_debugGibs;
 vmCvar_t	cg_errorDecay;
 vmCvar_t	cg_nopredict;
 vmCvar_t	cg_noPlayerAnims;
@@ -288,6 +289,7 @@ static cvarTable_t cvarTable[] = {
 	{ &cg_debugAnim, "cg_debuganim", "0", CVAR_CHEAT },
 	{ &cg_debugPosition, "cg_debugposition", "0", CVAR_CHEAT },
 	{ &cg_debugEvents, "cg_debugevents", "0", CVAR_CHEAT },
+	{ &cg_debugGibs, "cg_debugGibs", "0", CVAR_CHEAT },
 	{ &cg_errorDecay, "cg_errordecay", "100", 0 },
 	{ &cg_nopredict, "cg_nopredict", "0", 0 },
 	{ &cg_noPlayerAnims, "cg_noplayeranims", "0", CVAR_CHEAT },
-- 
2.55.0

